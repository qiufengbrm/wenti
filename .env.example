DATABASE_URL="mysql://wty_dev:your_password@localhost:3306/wty_center_dev"
FILE_STORAGE_ROOT="/var/lib/wenti-storage"
SOFFICE_PATH="/usr/bin/soffice"
FFMPEG_PATH="/usr/bin/ffmpeg"
TEMP_FILE_RETENTION_HOURS="24"
ORPHAN_PREVIEW_RETENTION_DAYS="7"
OFFICE_PREVIEW_RETENTION_DAYS="7"
TUTORIAL_INLINE_IMAGE_RETENTION_HOURS="24"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# 赛事排班表生成器：用于加密管理面板保存的共享 API Key。可用 `openssl rand -base64 32` 生成。
AI_SETTINGS_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# 可选后备值：管理面板尚未配置对应凭据时才会使用。
GLM_API_KEY=""
GLM_API_URL="https://open.bigmodel.cn/api/paas/v4/chat/completions"
GLM_MODEL="glm-5.3-flash"
GLM_TIMEOUT_MS="135000"
